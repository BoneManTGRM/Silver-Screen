# Silver-Screen 9.0 Autonomous Director

# Required for generated video.
REPLICATE_API_TOKEN=
SILVER_SCREEN_VIDEO_MODEL=google/veo-3.1-fast
SILVER_SCREEN_VIDEO_DURATION=8
SILVER_SCREEN_VIDEO_RESOLUTION=720p
SILVER_SCREEN_VIDEO_ASPECT_RATIO=16:9
SILVER_SCREEN_VIDEO_AUDIO=1

# Optional specialist model routes. Leave empty to use the active general model.
SILVER_SCREEN_MODEL_GENERAL=google/veo-3.1-fast
SILVER_SCREEN_MODEL_PERFORMANCE=
SILVER_SCREEN_MODEL_ACTION=
SILVER_SCREEN_MODEL_ENVIRONMENT=
SILVER_SCREEN_MODEL_DIALOGUE=
SILVER_SCREEN_MODEL_ANIMATION=
SILVER_SCREEN_MODEL_REPAIR=
SILVER_SCREEN_MODEL_UPSCALE=
SILVER_SCREEN_MODEL_LIP_SYNC=

# Optional semantic shot review through OpenAI.
OPENAI_API_KEY=
SILVER_SCREEN_SEMANTIC_REVIEW=1
SILVER_SCREEN_SEMANTIC_PROVIDER=1
SILVER_SCREEN_SEMANTIC_MODEL=gpt-5-mini
SILVER_SCREEN_SEMANTIC_ACCEPT_SCORE=0.76
SILVER_SCREEN_SEMANTIC_HARD_REJECT_SCORE=0.46
SILVER_SCREEN_SEMANTIC_SAMPLE_FRAMES=4
SILVER_SCREEN_SEMANTIC_MAX_IMAGE_BYTES=360000
SILVER_SCREEN_SEMANTIC_TIMEOUT_SECONDS=180
# Advisory by default. Enable only after calibration on your productions.
SILVER_SCREEN_SEMANTIC_GATE=0

# Existing local visual quality supervision.
SILVER_SCREEN_VISUAL_QUALITY_GATE=1
SILVER_SCREEN_VISUAL_ACCEPT_SCORE=0.68
SILVER_SCREEN_VISUAL_HARD_REJECT_SCORE=0.48
SILVER_SCREEN_VISUAL_MIN_SHARPNESS=0.18
SILVER_SCREEN_VISUAL_MAX_FLICKER=0.24
SILVER_SCREEN_VISUAL_MAX_FREEZE_RATIO=0.70
SILVER_SCREEN_VISUAL_MIN_IDENTITY=0.52
SILVER_SCREEN_VISUAL_SAMPLE_FRAMES=8
SILVER_SCREEN_VISUAL_MAX_RETAKES=2

# Candidate preservation and measured selection.
SILVER_SCREEN_CANDIDATE_MAX_RETAKES_PER_SHOT=3
SILVER_SCREEN_CANDIDATE_MIN_GAIN=0.015

# Existing durable generation and provider backoff.
SILVER_SCREEN_PROVIDER_429_RETRIES=3
SILVER_SCREEN_PROVIDER_429_MAX_WAIT_SECONDS=60
SILVER_SCREEN_VIDEO_MAX_SHOTS=128
SILVER_SCREEN_VIDEO_BATCH_SIZE=1
SILVER_SCREEN_VIDEO_MAX_RETRIES=2
SILVER_SCREEN_VIDEO_MAX_PROVIDER_CALLS=0
SILVER_SCREEN_VIDEO_MAX_SPEND_USD=0
SILVER_SCREEN_VIDEO_COST_PER_SECOND_USD=0
SILVER_SCREEN_VIDEO_CONTINUITY=1

# Cinematic assembly and professional delivery master.
SILVER_SCREEN_CINEMATIC_TRANSITIONS=1
SILVER_SCREEN_TRANSITION_MODE=auto
SILVER_SCREEN_TRANSITION_SAME_SCENE_SECONDS=0.26
SILVER_SCREEN_TRANSITION_SCENE_SECONDS=0.40
SILVER_SCREEN_TRANSITION_CHAPTER_SECONDS=0.58
SILVER_SCREEN_MASTER_PRESET=medium
SILVER_SCREEN_MASTER_CRF=17

# Optional voice finishing.
SILVER_SCREEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
SILVER_SCREEN_ELEVENLABS_MODEL=eleven_multilingual_v2

# Durable storage.
SILVER_SCREEN_RUNS_DIR=runs
