# Real AI video generation through Replicate.
REPLICATE_API_TOKEN=
SILVER_SCREEN_VIDEO_MODEL=google/veo-3.1-fast
SILVER_SCREEN_VIDEO_DURATION=8
SILVER_SCREEN_VIDEO_RESOLUTION=720p
SILVER_SCREEN_VIDEO_ASPECT_RATIO=16:9
SILVER_SCREEN_VIDEO_AUDIO=1
SILVER_SCREEN_VIDEO_CANCEL_AFTER=20m

# Bounded automatic backoff for explicit Replicate HTTP 429 responses.
SILVER_SCREEN_PROVIDER_429_RETRIES=3
SILVER_SCREEN_PROVIDER_429_MAX_WAIT_SECONDS=60

# Resumable long-film production. Zero values disable the related optional gate.
SILVER_SCREEN_TARGET_RUNTIME_SECONDS=60
SILVER_SCREEN_VIDEO_MAX_SHOTS=128
SILVER_SCREEN_VIDEO_BATCH_SIZE=4
SILVER_SCREEN_VIDEO_MAX_RETRIES=2
SILVER_SCREEN_VIDEO_MAX_PROVIDER_CALLS=0
SILVER_SCREEN_VIDEO_MAX_SPEND_USD=0
SILVER_SCREEN_VIDEO_COST_PER_SECOND_USD=0
SILVER_SCREEN_VIDEO_CONTINUITY=1
SILVER_SCREEN_VIDEO_CHAPTER_SIZE=12

# Shot Director defaults. These are local planning and provider-prompt controls.
SILVER_SCREEN_SHOT_AUDIO_STRATEGY=dub_later
SILVER_SCREEN_SHOT_COVERAGE_GATE=1
SILVER_SCREEN_SHOT_MAX_SIMILARITY=0.92
SILVER_SCREEN_SHOT_MIN_DISTINCT_RATIO=0.82

# Local cinematic transition engine. No additional API is required.
SILVER_SCREEN_CINEMATIC_TRANSITIONS=1
SILVER_SCREEN_TRANSITION_MODE=auto
SILVER_SCREEN_TRANSITION_SAME_SCENE_SECONDS=0.18
SILVER_SCREEN_TRANSITION_SCENE_SECONDS=0.32
SILVER_SCREEN_TRANSITION_CHAPTER_SECONDS=0.50
SILVER_SCREEN_TRANSITION_ANALYZE_FRAMES=1
SILVER_SCREEN_TRANSITION_FPS=24
SILVER_SCREEN_TRANSITION_MAX_WIDTH=1280
SILVER_SCREEN_TRANSITION_CRF=18

# Director Review. Retakes require explicit operator authorization in the UI.
SILVER_SCREEN_TRANSITION_RETAKE_THRESHOLD=0.64
SILVER_SCREEN_TRANSITION_MAX_RETAKES=2
SILVER_SCREEN_TRANSITION_RETAKE_MIN_GAIN=0.015

# Optional speech integrations. Use one provider or upload finished recordings.
OPENAI_API_KEY=
SILVER_SCREEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
SILVER_SCREEN_ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional secondary integrations.
DATABASE_URL=

# Durable Python pipeline storage. Use an attached volume in production.
SILVER_SCREEN_RUNS_DIR=runs

# Set to 1 only while diagnosing a controlled environment.
SILVER_SCREEN_DEBUG=0
