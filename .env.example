# Real AI video generation through Replicate.
REPLICATE_API_TOKEN=
SILVER_SCREEN_VIDEO_MODEL=google/veo-3.1-fast
SILVER_SCREEN_VIDEO_DURATION=8
SILVER_SCREEN_VIDEO_RESOLUTION=720p
SILVER_SCREEN_VIDEO_ASPECT_RATIO=16:9
SILVER_SCREEN_VIDEO_AUDIO=1
SILVER_SCREEN_VIDEO_CANCEL_AFTER=20m

# Bounded automatic backoff for explicit Replicate HTTP 429 responses.
SILVER_SCREEN_PROVIDER_429_RETRIES=3
SILVER_SCREEN_PROVIDER_429_MAX_WAIT_SECONDS=60

# Resumable long-film production. Zero values disable the related optional gate.
SILVER_SCREEN_TARGET_RUNTIME_SECONDS=60
SILVER_SCREEN_VIDEO_MAX_SHOTS=128
SILVER_SCREEN_VIDEO_BATCH_SIZE=4
SILVER_SCREEN_VIDEO_MAX_RETRIES=2
SILVER_SCREEN_VIDEO_MAX_PROVIDER_CALLS=0
SILVER_SCREEN_VIDEO_MAX_SPEND_USD=0
SILVER_SCREEN_VIDEO_COST_PER_SECOND_USD=0
SILVER_SCREEN_VIDEO_CONTINUITY=1
SILVER_SCREEN_VIDEO_CHAPTER_SIZE=12

# Shot Director defaults.
SILVER_SCREEN_SHOT_AUDIO_STRATEGY=dub_later
SILVER_SCREEN_SHOT_COVERAGE_GATE=1
SILVER_SCREEN_SHOT_MAX_SIMILARITY=0.92
SILVER_SCREEN_SHOT_MIN_DISTINCT_RATIO=0.82

# Persistent project memory. Memory is bounded and compacted automatically.
SILVER_SCREEN_MEMORY_MAX_SHOTS=1200
SILVER_SCREEN_MEMORY_MAX_EVENTS=500
SILVER_SCREEN_MEMORY_MAX_SCARS=300

# Capability-aware routing. Specialists remain advisory until an adapter is enabled.
SILVER_SCREEN_AUTO_MODEL_ROUTING=1
SILVER_SCREEN_EXECUTE_SPECIALIST_MODELS=0
SILVER_SCREEN_AVAILABLE_VIDEO_MODELS=

# Visual Quality and Identity Supervisor. Analysis is local and non-biometric.
SILVER_SCREEN_VISUAL_QUALITY_GATE=1
SILVER_SCREEN_VISUAL_ACCEPT_SCORE=0.68
SILVER_SCREEN_VISUAL_HARD_REJECT_SCORE=0.48
SILVER_SCREEN_VISUAL_MIN_SHARPNESS=0.18
SILVER_SCREEN_VISUAL_MAX_FLICKER=0.24
SILVER_SCREEN_VISUAL_MAX_FREEZE_RATIO=0.70
SILVER_SCREEN_VISUAL_MIN_IDENTITY=0.52
SILVER_SCREEN_VISUAL_SAMPLE_FRAMES=8
SILVER_SCREEN_VISUAL_MAX_RETAKES=2

# Optional semantic shot review. It runs only with explicit operator authorization.
SILVER_SCREEN_SEMANTIC_QA=1
SILVER_SCREEN_SEMANTIC_QA_MODE=auto
SILVER_SCREEN_SEMANTIC_QA_AUTHORIZED=0
SILVER_SCREEN_SEMANTIC_MODEL=gpt-5.6-luna
SILVER_SCREEN_SEMANTIC_TARGET=0.84
SILVER_SCREEN_SEMANTIC_HARD_REJECT=0.58
SILVER_SCREEN_SEMANTIC_MIN_CONFIDENCE=0.62
SILVER_SCREEN_SEMANTIC_SAMPLE_FRAMES=4
SILVER_SCREEN_SEMANTIC_MAX_IMAGE_BYTES=350000

# Bounded closed-loop Autonomous Director repair. It never increases the operator's
# approved provider-call or dollar ceiling. The original accepted clip is restored
# automatically unless the replacement produces the configured verified gain.
SILVER_SCREEN_AUTONOMOUS_AUTO_SEMANTIC_REPAIR=1
SILVER_SCREEN_AUTONOMOUS_MAX_SEMANTIC_RETAKES_PER_RUN=2
SILVER_SCREEN_AUTONOMOUS_MAX_SEMANTIC_RETAKES_PER_SHOT=2
SILVER_SCREEN_AUTONOMOUS_RETAKE_MIN_GAIN=0.015

# Local cinematic transition engine. No additional API is required.
SILVER_SCREEN_CINEMATIC_TRANSITIONS=1
SILVER_SCREEN_TRANSITION_MODE=auto
SILVER_SCREEN_TRANSITION_SAME_SCENE_SECONDS=0.26
SILVER_SCREEN_TRANSITION_SCENE_SECONDS=0.40
SILVER_SCREEN_TRANSITION_CHAPTER_SECONDS=0.58
SILVER_SCREEN_TRANSITION_ANALYZE_FRAMES=1
SILVER_SCREEN_TRANSITION_FPS=24
SILVER_SCREEN_TRANSITION_MAX_WIDTH=1280
SILVER_SCREEN_TRANSITION_CRF=18

# Director Review. Retakes require explicit operator authorization in the UI.
SILVER_SCREEN_TRANSITION_RETAKE_THRESHOLD=0.64
SILVER_SCREEN_TRANSITION_MAX_RETAKES=2
SILVER_SCREEN_TRANSITION_RETAKE_MIN_GAIN=0.015

# Optional speech and semantic integrations.
OPENAI_API_KEY=
SILVER_SCREEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
SILVER_SCREEN_ELEVENLABS_MODEL=eleven_multilingual_v2

DATABASE_URL=
SILVER_SCREEN_RUNS_DIR=runs
SILVER_SCREEN_DEBUG=0
